{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "inline-skills/**/*.ts",
    "dj/**/*.ts",
    "modes/**/*.ts",
    "whimsical/**/*.ts",
    "tests/**/*.ts"
  ]
}
