{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "description": "Independently installable Pi extensions.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "ask-user-question/index.ts",
      "cd/index.ts",
      "claude-bridge/index.ts",
      "dj/index.ts",
      "intercom/index.ts",
      "modes/index.ts",
      "reply/index.ts",
      "rewind/index.ts",
      "stash/index.ts",
      "todo/index.ts",
      "whimsical/index.ts"
    ],
    "skills": [
      "intercom/skills"
    ]
  },
  "workspaces": [
    "ask-user-question",
    "cd",
    "claude-bridge",
    "dj",
    "intercom",
    "modes",
    "reply",
    "rewind",
    "stash",
    "todo",
    "whimsical"
  ],
  "scripts": {
    "check": "../pi/node_modules/.bin/biome check --write . && bun run typecheck",
    "test": "bun test",
    "typecheck": "../pi/node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.308",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cc-session-io": "^0.4.1",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4",
    "bun-types": "1.4.1"
  }
}
