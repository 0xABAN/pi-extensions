{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "description": "Independently installable Pi extensions.",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "dj/index.ts",
      "modes/index.ts",
      "whimsical/index.ts"
    ]
  },
  "workspaces": [
    "dj",
    "modes",
    "whimsical",
    "powerline",
    "todo",
    "ask-user-question",
    "intercom",
    "claude-bridge",
    "ponytail"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/bun": "^1.3.11",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0"
  }
}
