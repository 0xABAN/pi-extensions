{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "description": "Independently installable Pi extensions.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "cd/index.ts",
      "dj/index.ts",
      "modes/index.ts",
      "reply/index.ts",
      "stash/index.ts",
      "whimsical/index.ts"
    ]
  },
  "workspaces": [
    "cd",
    "dj",
    "modes",
    "reply",
    "stash",
    "whimsical",
    "todo",
    "ask-user-question",
    "intercom",
    "claude-bridge"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "../pi/node_modules/.bin/tsc --noEmit"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4",
    "bun-types": "1.4.1"
  }
}
